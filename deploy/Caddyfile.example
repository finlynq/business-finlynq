business.finlynq.com {
  encode zstd gzip

  @auth_mutations {
    path /api/auth/*
    method POST
  }
  request_body @auth_mutations {
    max_size 16KB
  }

  reverse_proxy 127.0.0.1:3100 {
    # Only direct loopback probes may request the detailed readiness payload.
    # Remove any client attempt before proxying.
    header_up -X-Business-Finlynq-Internal-Health
    health_uri /api/health
    health_interval 30s
    health_timeout 5s
  }

  header {
    Strict-Transport-Security "max-age=31536000; includeSubDomains"
    X-Content-Type-Options "nosniff"
    X-Frame-Options "DENY"
    Referrer-Policy "strict-origin-when-cross-origin"
    -Server
  }

  log {
    output file /var/log/caddy/business-finlynq.access.log {
      roll_size 20MiB
      roll_keep 10
    }
  }
}
