[Unit]
Description=Independent private FinLynQ file scanner
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/opt/finlynq-shared-scanner/manage.sh start
RemainAfterExit=yes
TimeoutStartSec=360
UMask=0077

[Install]
WantedBy=multi-user.target
