{
	admin 127.0.0.1:2019
}

{$BUSINESS_FINLYNQ_HOSTNAME:business.finlynq.com} {
	encode zstd gzip

	@auth_mutations {
		path /api/auth/*
		method POST
	}
	request_body @auth_mutations {
		max_size 16KB
	}

	reverse_proxy production-app:3000 {
		# Only direct private-network/loopback probes may request the detailed
		# readiness payload. Remove any client attempt before proxying.
		header_up -X-Business-Finlynq-Internal-Health
		header_up -X-Business-Finlynq-Internal-Metrics
		# Overwrite every client-supplied correlation value at the public edge.
		header_up -X-Request-Id
		header_up X-Request-Id {http.request.uuid}
		health_uri /api/health
		health_interval 30s
		health_timeout 5s
	}

	header {
		X-Request-Id "{http.request.uuid}"
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}

	# Bind the access event to the same edge UUID sent upstream and returned by
	# the application. Never use the untrusted inbound header as correlation.
	log_append request_id {http.request.uuid}

	log {
		output stdout
		format json
	}
}

{$BUSINESS_FINLYNQ_DEVELOPMENT_HOSTNAME:dev.business.finlynq.com} {
	encode zstd gzip

	@auth_mutations {
		path /api/auth/*
		method POST
	}
	request_body @auth_mutations {
		max_size 16KB
	}

	reverse_proxy development-app:3000 {
		# Development has its own application, database, secrets, and network.
		# Keep internal health/metrics details inaccessible at the public edge.
		header_up -X-Business-Finlynq-Internal-Health
		header_up -X-Business-Finlynq-Internal-Metrics
		header_up -X-Request-Id
		header_up X-Request-Id {http.request.uuid}
		health_uri /api/health
		health_interval 30s
		health_timeout 5s
	}

	header {
		X-Request-Id "{http.request.uuid}"
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}

	log_append request_id {http.request.uuid}

	log {
		output stdout
		format json
	}
}

{$EPM_FINLYNQ_HOSTNAME:epm.finlynq.com} {
	encode zstd gzip

	@planning_agent_api path /v1/*
	handle @planning_agent_api {
		request_body {
			max_size 4MB
		}

		reverse_proxy epm-finlynq-api:7100 {
			header_up -Forwarded
			header_up -X-Tenant-Id
			header_up -X-Principal-Id
			header_up -X-Planning-Principal-Id
			header_up -X-Policy
			header_up -X-Executor
			health_uri /health
			health_interval 30s
			health_timeout 5s
		}
	}

	handle {
		basic_auth {
			import /etc/caddy/epm-basic-auth
		}

		request_body {
			max_size 32MB
		}

		reverse_proxy epm-finlynq-console:7090 {
			header_up -Authorization
			header_up -Proxy-Authorization
			header_up -Forwarded
			header_up -X-Tenant-Id
			header_up -X-Principal-Id
			header_up -X-Planning-Principal-Id
			header_up -X-Forwarded-User
			header_up -X-Forwarded-Email
			header_up -X-Forwarded-Groups
			header_up -X-Forwarded-Tenant-Id
			header_up -X-Forwarded-Principal-Id
			header_up -X-Auth-Request-User
			header_up -X-Auth-Request-Email
			header_up -X-Auth-Request-Groups
			header_up -X-Remote-User
			header_up -Remote-User
			header_up -X-Policy
			header_up -X-Executor
			health_uri /api/health
			health_interval 30s
			health_timeout 5s
		}
	}

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "no-referrer"
		-Server
	}

	log {
		output stdout
		format json
	}
}
