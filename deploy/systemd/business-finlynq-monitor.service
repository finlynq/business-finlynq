[Unit]
Description=Business Finlynq production readiness monitor
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target
OnFailure=business-finlynq-monitor-notify@%n.service

[Service]
Type=oneshot
WorkingDirectory=/home/deploy/business-finlynq
EnvironmentFile=/etc/business-finlynq/operations.env
ExecStart=/home/deploy/business-finlynq/deploy/monitoring/check-production.sh
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=read-only
TimeoutStartSec=2m
