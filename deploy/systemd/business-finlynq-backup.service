[Unit]
Description=Business Finlynq encrypted PostgreSQL backup
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target
OnFailure=business-finlynq-monitor-notify@%n.service

[Service]
Type=oneshot
WorkingDirectory=/home/deploy/business-finlynq
EnvironmentFile=/etc/business-finlynq/operations.env
ExecCondition=/bin/bash /home/deploy/business-finlynq/deploy/systemd/check-scheduler-boundary.sh
ExecStart=/home/deploy/business-finlynq/deploy/backup/run-scheduled-backup.sh
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=6
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=read-only
TimeoutStartSec=95m
