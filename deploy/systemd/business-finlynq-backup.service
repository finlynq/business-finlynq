[Unit]
Description=Business Finlynq encrypted PostgreSQL backup
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target
OnFailure=business-finlynq-monitor-notify@%n.service

[Service]
Type=oneshot
WorkingDirectory=/opt/business-finlynq/current
EnvironmentFile=-/etc/business-finlynq/operations.env
ExecStart=/opt/business-finlynq/current/deploy/backup/run-scheduled-backup.sh
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=6
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=read-only
TimeoutStartSec=2h
