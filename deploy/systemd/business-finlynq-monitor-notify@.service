[Unit]
Description=Notify operators that %i failed
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
EnvironmentFile=-/etc/business-finlynq/operations.env
Environment=MONITOR_FAILED_UNIT=%i
ExecStart=/opt/business-finlynq/current/deploy/monitoring/notify-failure.sh
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
TimeoutStartSec=1m
