# Local development connection examples. Never commit real credentials.
DATABASE_URL=postgresql://business_finlynq_app:change-me@127.0.0.1:5432/business_finlynq
DATABASE_MIGRATION_URL=postgresql://business_finlynq_owner:change-me@127.0.0.1:5432/business_finlynq
# Disposable PostgreSQL integration-test database. These three URLs must point
# to the same test database through its owner, runtime, and auth-worker roles.
# Leave them unset only when intentionally running the unit-only test subset;
# Vitest prints a prominent warning whenever database suites are skipped.
TEST_DATABASE_URL=
TEST_APP_DATABASE_URL=
TEST_AUTH_WORKER_DATABASE_URL=
APP_ORIGIN=http://localhost:3000
# Leave this unset or 0 when Next.js is reached directly. Both reviewed Caddy
# arrangements are exactly one trusted hop, so their production environment
# must set TRUSTED_PROXY_HOPS=1. Never count a proxy the operator does not own.
TRUSTED_PROXY_HOPS=0
# Production should use this host-only cookie name. For plain-HTTP local
# development use business_finlynq_session because browsers reject __Host-
# cookies without Secure.
SESSION_COOKIE_NAME=__Host-business_finlynq_session
DEMO_CLAIM_COOKIE_NAME=__Host-business_finlynq_demo_claim
DEMO_LOGIN_ENABLED=true
# Public visitors receive isolated, disposable synthetic organizations. This
# gate authorizes writes only for live demo-link sessions in SANDBOX-mode
# organizations; it does not enable writes for real business organizations.
DEMO_WRITES_ENABLED=true
# Keep real account login and recovery unavailable for the hosted demo.
# Enabling it requires configured email delivery and the real-account launch
# gates described in the operations documentation.
ACCOUNT_LOGIN_ENABLED=false
# Self-service owner acquisition is an independent gate. Production requires
# verified email delivery and a hostname-bound Turnstile site/secret pair.
ACCOUNT_SIGNUP_ENABLED=false
SIGNUP_TURNSTILE_ENABLED=false
SIGNUP_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY_FILE=/etc/business-finlynq/secrets/turnstile-secret-key
# Compose uses this hostname for the application origin and the optional Caddy
# edge profile. DNS must point it to the dedicated server before enabling edge.
BUSINESS_FINLYNQ_HOSTNAME=business.finlynq.com
# Do not enable this on a workstation or a server with another 80/443 owner.
# COMPOSE_PROFILES=edge
# Keep real-organization accounting mutations fail-closed. This is independent
# from DEMO_WRITES_ENABLED and must remain false for the public demo release.
BUSINESS_WRITES_ENABLED=false
# Live SimpleFIN setup-token exchange and synchronization are a separate,
# fail-closed gate. Synthetic demo banking remains available when this is false.
BANK_FEEDS_ENABLED=false

# Compose bootstrap credentials. Use independent generated values.
POSTGRES_PASSWORD=change-me
APP_DATABASE_PASSWORD_FILE=/etc/business-finlynq/secrets/app-db-password
AUTH_WORKER_DATABASE_PASSWORD_FILE=/etc/business-finlynq/secrets/auth-worker-db-password

# Host path to a file containing exactly one base64-encoded 32-byte wrapping key.
# Compose mounts this as /run/secrets/business_finlynq_root_kek instead of
# exposing the key through the container environment. The source file should be
# root-owned, group-readable only by BUSINESS_FINLYNQ_SECRET_GID, and mode 0440.
ORGANIZATION_ROOT_KEK_FILE=/etc/business-finlynq/secrets/organization-root-kek
IDENTITY_SECRET_FILE=/etc/business-finlynq/secrets/identity-secret
BUSINESS_FINLYNQ_SECRET_GID=20001

# Real login stays fail-closed until delivery is enabled, the auth-email
# Compose profile is running, and its database heartbeat is fresh. The Resend
# key is mounted only into that worker; the app and invitation tool use only
# non-secret delivery metadata. Never use an inline production provider key.
AUTH_EMAIL_DELIVERY_ENABLED=false
AUTH_EMAIL_PROVIDER=resend
AUTH_EMAIL_FROM=Business Finlynq <security@finlynq.com>
AUTH_EMAIL_REPLY_TO=
AUTH_RESEND_API_KEY_FILE=/etc/business-finlynq/secrets/resend-api-key

# Encrypted database backups. Generate the database password independently.
# This file is required for every Compose rollout because the post-migration
# backup-role grant reconciliation gates demo bootstrap and application start.
# The age recipient is public and may live on the VPS; its private identity must
# remain separately escrowed and is supplied only on an isolated drill host.
BACKUP_DATABASE_PASSWORD_FILE=/etc/business-finlynq/secrets/backup-db-password
BACKUP_AGE_RECIPIENT_FILE=/etc/business-finlynq/backup/age-recipients.txt
BACKUP_AGE_IDENTITY_FILE=/etc/business-finlynq/recovery/age-identity.txt
BACKUP_RCLONE_CONFIG_FILE=/etc/business-finlynq/secrets/rclone.conf
BACKUP_RECEIVER_SSH_PRIVATE_KEY_FILE=/etc/business-finlynq/secrets/backup-receiver-ssh-private-key
BACKUP_RECEIVER_KNOWN_HOSTS_FILE=/etc/business-finlynq/backup/receiver-known-hosts
BACKUP_RCLONE_REMOTE=offsite:business-finlynq/database
BACKUP_LOCAL_DIR=/var/backups/business-finlynq
BACKUP_LOCAL_RETENTION_DAYS=14
BACKUP_REQUIRE_OFFSITE=true
RESTORE_DATABASE_PASSWORD_FILE=/etc/business-finlynq/recovery/restore-db-password
RESTORE_BACKUP_MANIFEST=
RESTORE_REQUIRE_WRAPPED_KEYS=true
RESTORE_REQUIRE_ENCRYPTED_IDENTITIES=false

# Set this to the exact deployed Git SHA in the release environment so internal
# readiness responses and backup manifests identify an immutable build.
BUSINESS_FINLYNQ_IMAGE_REVISION=0000000000000000000000000000000000000000

# Host monitor thresholds. Production requires the off-site upload marker.
MONITOR_HOSTNAME=business.finlynq.com
MONITOR_BASE_URL=https://business.finlynq.com
MONITOR_BACKUP_DIR=/var/backups/business-finlynq
MONITOR_MAX_BACKUP_AGE_HOURS=8
MONITOR_MAX_BACKUP_ACTIVE_SECONDS=7200
MONITOR_BACKUP_VERIFY_TIMEOUT_SECONDS=90
MONITOR_MIN_TLS_DAYS=21
MONITOR_MAX_DISK_PERCENT=85
MONITOR_EXPECT_EDGE=true
MONITOR_EXPECT_AUTH_EMAIL_WORKER=false
MONITOR_EXPECT_DEMO_LOGIN_ENABLED=true
MONITOR_EXPECT_DEMO_WRITES_ENABLED=true
MONITOR_EXPECT_ACCOUNT_LOGIN_ENABLED=false
MONITOR_EXPECT_ACCOUNT_SIGNUP_ENABLED=false
MONITOR_EXPECT_BUSINESS_WRITES_ENABLED=false
MONITOR_EXPECT_BANK_FEEDS_ENABLED=false
MONITOR_EXPECT_DEMO_MAINTENANCE=true
# Keep systemd for the root-installed timers. Set cron only when the reviewed
# deploy-owned fallback in deploy/cron is installed for the deploy user.
MONITOR_MAINTENANCE_SCHEDULER=systemd
MONITOR_EXPECT_DEMO_POOL_SIZE=128
MONITOR_MIN_DEMO_READY_SLOTS=4
MONITOR_REQUIRE_OFFSITE=true
MONITOR_EXPECT_REVISION=0000000000000000000000000000000000000000
MONITOR_ALERT_WEBHOOK_URL_FILE=/etc/business-finlynq/secrets/monitor-webhook-url
