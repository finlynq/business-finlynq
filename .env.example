# Local development connection examples. Never commit real credentials.
DATABASE_URL=postgresql://business_finlynq_app:change-me@127.0.0.1:5432/business_finlynq
DATABASE_MIGRATION_URL=postgresql://business_finlynq_owner:change-me@127.0.0.1:5432/business_finlynq
APP_ORIGIN=http://localhost:3000
SESSION_COOKIE_NAME=business_finlynq_session
# Compose uses this hostname for the application origin and the optional Caddy
# edge profile. DNS must point it to the dedicated server before enabling edge.
BUSINESS_FINLYNQ_HOSTNAME=business.finlynq.com
# Do not enable this on a workstation or a server with another 80/443 owner.
# COMPOSE_PROFILES=edge
# Keep real accounting mutations fail-closed until authenticated sessions,
# organization recovery, and encrypted persistence are configured and tested.
BUSINESS_WRITES_ENABLED=false

# Compose bootstrap credentials. Use independent generated values.
POSTGRES_PASSWORD=change-me
APP_DATABASE_PASSWORD=change-me

# Host path to a file containing exactly one base64-encoded 32-byte wrapping key.
# Compose mounts this as /run/secrets/business_finlynq_root_kek instead of
# exposing the key through the container environment. The source file should be
# root-owned, group-readable only by BUSINESS_FINLYNQ_SECRET_GID, and mode 0440.
ORGANIZATION_ROOT_KEK_FILE=/etc/business-finlynq/secrets/organization-root-kek
BUSINESS_FINLYNQ_SECRET_GID=20001
